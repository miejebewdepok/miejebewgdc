# Postgres connection string. Local Docker default uses port 5439 (see README).
DATABASE_URL=postgres://postgres:postgres@localhost:5439/warungos

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter API Key & Free AI Model Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Integrasi Rania Finance — Webhook otomatis setiap transaksi sukses
# URL endpoint webhook Rania Finance (kosongkan jika belum aktif)
RANIA_FINANCE_WEBHOOK_URL=https://raniafinance.vercel.app/api/fnb-sales/webhook
# Secret harus sama persis dengan WEBHOOK_SECRET di project Rania Finance
# Generate: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
RANIA_FINANCE_WEBHOOK_SECRET=ganti-dengan-secret-yang-sama-di-rania-finance
